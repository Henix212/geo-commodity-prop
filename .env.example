# Example environment overrides (copy to .env and adjust)

GCP_DEVICE=cpu
GCP_SECTOR=energy
GCP_COMMODITY=oil
GCP_LOG_LEVEL=INFO

# Paths (defaults shown — usually leave unset)
# GCP_DATA_DIR=./data
# GCP_DB_PATH=./data/db/geo_commodity.db
# GCP_GNN_CHECKPOINT=./data/checkpoints/best.pt
# GCP_LLM_MODEL=./data/cache/models/Qwen2.5-7B-Instruct
# GCP_NETWORK_DATA_DIR=./datasets/network

# Event decay / thresholds
# GCP_EVENT_DECAY_HALF_LIFE_HOURS=72
# GCP_TENSION_LONG=0.65
# GCP_TENSION_SHORT=0.35
